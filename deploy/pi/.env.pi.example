# Copy to deploy/pi/.env.pi and adjust values.

POSTGRES_USER=draftday
POSTGRES_PASSWORD=change-me
POSTGRES_DB=draftday

# Feature toggles from backend config
ENABLE_DRAFT_INTELLIGENCE=true
ENABLE_ORG_INTELLIGENCE=true

# Internal service URL used by the frontend container
NEXT_PUBLIC_API_BASE_URL=http://api:8000

# Public HTTP port exposed by Caddy on the Raspberry Pi
PUBLIC_HTTP_PORT=80
